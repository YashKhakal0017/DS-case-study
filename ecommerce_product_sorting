"""
E-commerce Product Sorting using Divide and Conquer
Algorithm: Merge Sort
Run: python ecommerce_product_sorting.py
"""

products = [
    {"id": 101, "name": "Wireless Mouse", "price": 799.00, "rating": 4.4},
    {"id": 102, "name": "Keyboard", "price": 1299.00, "rating": 4.6},
    {"id": 103, "name": "USB-C Cable", "price": 299.00, "rating": 4.1},
    {"id": 104, "name": "Headphones", "price": 2499.00, "rating": 4.7},
    {"id": 105, "name": "Laptop Stand", "price": 999.00, "rating": 4.3},
]


def merge_sort(items, key, descending=False):
    """Return a sorted copy of items using the Merge Sort algorithm."""
    if len(items) <= 1:
        return items[:]

    middle = len(items) // 2
    left = merge_sort(items[:middle], key, descending)
    right = merge_sort(items[middle:], key, descending)

    return merge(left, right, key, descending)


def merge(left, right, key, descending):
    """Merge two already-sorted lists into one sorted list."""
    result = []
    i = j = 0

    while i < len(left) and j < len(right):
        left_value = left[i][key]
        right_value = right[j][key]

        if (left_value >= right_value) if descending else (left_value <= right_value):
            result.append(left[i])
            i += 1
        else:
            result.append(right[j])
            j += 1

    result.extend(left[i:])
    result.extend(right[j:])
    return result


def display_products(items):
    print(f"{'ID':<6}{'Product':<20}{'Price (₹)':>12}{'Rating':>10}")
    print("-" * 48)
    for product in items:
        print(
            f"{product['id']:<6}"
            f"{product['name']:<20}"
            f"{product['price']:>12.2f}"
            f"{product['rating']:>10.1f}"
        )


def main():
    print("E-COMMERCE PRODUCT SORTING")
    print("\nAvailable products:")
    display_products(products)

    print("\nSort by:")
    print("1. Price (low to high)")
    print("2. Price (high to low)")
    print("3. Rating (high to low)")
    print("4. Product name (A to Z)")

    choice = input("Enter your choice (1-4): ").strip()

    if choice == "1":
        sorted_products = merge_sort(products, "price")
    elif choice == "2":
        sorted_products = merge_sort(products, "price", descending=True)
    elif choice == "3":
        sorted_products = merge_sort(products, "rating", descending=True)
    elif choice == "4":
        # Case-insensitive alphabetical sorting is handled by a normalized key.
        normalized = [dict(p, sort_name=p["name"].lower()) for p in products]
        sorted_products = merge_sort(normalized, "sort_name")
        sorted_products = [
            {k: v for k, v in p.items() if k != "sort_name"}
            for p in sorted_products
        ]
    else:
        print("Invalid choice. Please run the program again and select 1-4.")
        return

    print("\nSorted products:")
    display_products(sorted_products)


if __name__ == "__main__":
    main()

